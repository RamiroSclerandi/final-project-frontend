# Copy to .env and fill in the values from your Supabase project (Settings > API).
# Only the URL and the anon key may ever reach the browser. The anon key is public by
# design and relies on row level security; the service_role key must never appear here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used only by `pnpm gen:types`, never by the app.
SUPABASE_PROJECT_ID=your-project-ref